{
  "name": "@authon/nuxt",
  "version": "0.3.3",
  "description": "Authon Nuxt 3 module — auto-imported composables and middleware",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --root ../.. --passWithNoTests packages/nuxt",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikusnuz/authon-sdk.git",
    "directory": "packages/nuxt"
  },
  "homepage": "https://github.com/mikusnuz/authon-sdk/tree/main/packages/nuxt",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "authon",
    "nuxt",
    "auth",
    "module"
  ],
  "dependencies": {
    "@authon/js": "workspace:^",
    "@authon/shared": "workspace:^",
    "@authon/vue": "workspace:^",
    "@nuxt/kit": "^3.21.1"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vue": "^3.4.0"
  }
}
