{
  "name": "authon-sdk",
  "private": true,
  "scripts": {
    "build": "pnpm build:packages && pnpm build:examples",
    "build:packages": "pnpm --filter './packages/*' build",
    "build:examples": "pnpm --filter './examples/*' build",
    "dev": "pnpm -r --parallel dev",
    "test": "vitest run",
    "test:package-contents": "node scripts/check-package-contents.mjs",
    "typecheck": "pnpm --filter './packages/*' typecheck && tsc --project tsconfig.test.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
