# Authon Examples - Shared Configuration
AUTHON_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
AUTHON_API_URL=https://api.authon.dev
AUTHON_FRONTEND_URL=https://authon.dev

# Vite frontend examples (Vite requires VITE_ prefix)
VITE_AUTHON_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
VITE_AUTHON_API_URL=https://api.authon.dev

# Backend examples only
AUTHON_SECRET_KEY=sk_test_your_secret_key_here
AUTHON_WEBHOOK_SECRET=<your-webhook-secret>

# Next.js (build-time)
NEXT_PUBLIC_AUTHON_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
NEXT_PUBLIC_AUTHON_API_URL=https://api.authon.dev

# Nuxt (runtime)
NUXT_PUBLIC_AUTHON_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
NUXT_PUBLIC_AUTHON_API_URL=https://api.authon.dev

# SvelteKit (runtime)
PUBLIC_AUTHON_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
PUBLIC_AUTHON_API_URL=https://api.authon.dev
SVELTE_ORIGIN=https://your-domain.com
